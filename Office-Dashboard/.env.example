# Environment Configuration
# Copy to .env and configure

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hair_rap_dev"

# JWT Secret for dashboard auth
JWT_SECRET="change-me-to-a-secure-random-string"
LAUNCH_TICKET_SECRET="replace-with-an-independent-random-64-character-secret"
JWT_EXPIRES_IN="24h"

# Credential Encryption Key (AES-256-GCM)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="change-me-to-64-hex-chars"
CREDENTIAL_KEY_VERSION=1

# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Launcher Communication
LAUNCHER_HEARTBEAT_INTERVAL_MS=60000
LAUNCHER_REQUEST_TIMEOUT_MS=30000

# WhatsApp Sessions Base Path (on launcher PCs)
WHATSAPP_SESSIONS_BASE_PATH="C:\\HairRap\\WhatsAppSessions"
